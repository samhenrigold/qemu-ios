diff --git a/src/libslirp.h b/src/libslirp.h
index 240dfe8b..f96ddbbc 100644
--- a/src/libslirp.h
+++ b/src/libslirp.h
@@ -268,6 +268,28 @@ Slirp *slirp_init(int restricted, bool in_enabled, struct in_addr vnetwork,
 SLIRP_EXPORT
 void slirp_cleanup(Slirp *slirp);
 
+/* Change the "restricted" flag on a running instance, in place. With it set,
+ * the guest may only reach the gateway services (DHCP/DNS and forwards);
+ * cleared, guest-initiated outbound connections are allowed again. Takes
+ * effect on the next connection attempt -- no link event, no DHCP change. */
+SLIRP_EXPORT
+void slirp_set_restricted(Slirp *slirp, int restricted);
+
+/* Allow or refuse guest traffic to local-network destinations on the host's
+ * side (10/8, 172.16/12, 192.168/16, 169.254/16, 224/4, fc00::/7, fe80::/10,
+ * ff00::/8). Refused, such a connection or datagram fails as if unreachable;
+ * loopback forwards stay reachable, and so does the host's own DNS server (the
+ * guest's 10.0.2.3) unless slirp_set_dns_forward gives a resolver instead. Allowed by default; takes effect on the next connection. */
+SLIRP_EXPORT
+void slirp_set_local_network(Slirp *slirp, int allowed);
+
+/* While the local network is refused, the guest's UDP DNS (to its virtual
+ * nameserver, port 53) goes to `addr` -- a resolver on the host's loopback that
+ * asks the system resolver -- instead of the host's DNS server, which usually
+ * sits on the LAN; other DNS to the virtual nameserver is refused. NULL clears. */
+SLIRP_EXPORT
+void slirp_set_dns_forward(Slirp *slirp, const struct sockaddr_in *addr);
+
 /* This is deprecated, use slirp_pollfds_fill_socket instead. */
 SLIRP_EXPORT
 void slirp_pollfds_fill(Slirp *slirp, uint32_t *timeout,
diff --git a/src/slirp.c b/src/slirp.c
index 0fc51a96..e30c2194 100644
--- a/src/slirp.c
+++ b/src/slirp.c
@@ -782,6 +782,38 @@ void slirp_cleanup(Slirp *slirp)
     g_free(slirp);
 }
 
+void slirp_set_restricted(Slirp *slirp, int restricted)
+{
+    slirp->restricted = restricted;
+}
+
+void slirp_set_local_network(Slirp *slirp, int allowed)
+{
+    slirp->local_network_blocked = !allowed;
+}
+
+void slirp_set_dns_forward(Slirp *slirp, const struct sockaddr_in *addr)
+{
+    memset(&slirp->dns_forward, 0, sizeof(slirp->dns_forward));
+    if (addr) {
+        slirp->dns_forward = *addr;
+    }
+}
+
+bool slirp_local_network_addr4(struct in_addr a)
+{
+    uint32_t h = ntohl(a.s_addr);
+    return (h >> 24) == 10 || (h >> 20) == 0xac1 || (h >> 16) == 0xc0a8 ||
+           (h >> 16) == 0xa9fe || (h >> 28) == 0xe || h == 0xffffffff;
+}
+
+bool slirp_local_network_addr6(const struct in6_addr *a)
+{
+    const uint8_t *b = a->s6_addr;
+    return (b[0] & 0xfe) == 0xfc || (b[0] == 0xfe && (b[1] & 0xc0) == 0x80) ||
+           b[0] == 0xff;
+}
+
 #define CONN_CANFSEND(so) \
     (((so)->so_state & (SS_FCANTSENDMORE | SS_ISFCONNECTED)) == SS_ISFCONNECTED)
 #define CONN_CANFRCV(so) \
