<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.qemu.hidbridge</string>
	<!-- hidbridge.dylib's constructor never returns, so the host binary never runs;
	     launchctl is the one executable in /bin on a stock 3.2.2 rootfs. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/launchctl</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>DYLD_INSERT_LIBRARIES</key>
		<string>/usr/local/lib/hidbridge.dylib</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/hidbridge.log</string>
</dict>
</plist>
