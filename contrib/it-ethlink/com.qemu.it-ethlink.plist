<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Raises the USB Ethernet link when a host bridges it (it_ethlink.c). Root-owned
  in /System/Library/LaunchDaemons, or launchd ignores it; baked by
  imgtools/ipad1_rootfs.py bake.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.qemu.it-ethlink</string>
	<key>POSIXSpawnType</key>
	<string>Interactive</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/it_ethlink</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/dev/console</string>
</dict>
</plist>
