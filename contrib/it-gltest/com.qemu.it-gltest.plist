<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The GL fixture (it_gltest.c): draws a known scene through GL once per boot.
  Only `ipad1_rootfs.py bake --gl-test` installs it (ipad1_device.py create --gl-test).
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.qemu.it-gltest</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/it_gltest</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/dev/console</string>
</dict>
</plist>
